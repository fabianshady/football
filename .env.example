# Completar una pareja. Solo credenciales publicables/anon; nunca service_role.
# Pareja preferida para el cliente de servidor del sitio público:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Alternativa compatible, compartida con la administración:
# Para usarla, eliminar la pareja SUPABASE_* de arriba y descomentar esta pareja.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Alternativa legacy opcional, si no se usa una clave publicable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen canónico opcional (predeterminado: https://itjaguars.fabianms.com).
# SITE_URL=https://itjaguars.fabianms.com
# Docker/hosting propio: production permite indexar; preview/development lo impiden.
# SITE_ENV=production
# VERCEL_ENV tiene prioridad y se configura automáticamente en Vercel.
